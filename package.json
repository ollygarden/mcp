{
	"name": "ollygarden-mcp",
	"version": "0.0.1",
	"type": "module",
	"private": true,
	"devDependencies": {
		"@biomejs/biome": "2.3.14",
		"@modelcontextprotocol/inspector": "^2.3.0",
		"@types/bun": "latest",
		"concurrently": "^10.0.5",
		"vitest": "3.2.7"
	},
	"peerDependencies": {
		"typescript": "^5"
	},
	"dependencies": {
		"@clerk/hono": "^0.1.71",
		"@clerk/mcp-tools": "^0.6.0",
		"@modelcontextprotocol/server": "^2.0.0",
		"hono": "^4.13.3",
		"jose": "^6.2.9",
		"zod": "^4.4.3"
	},
	"scripts": {
		"start": "bun src/index.ts",
		"dev": "concurrently -k -n server,inspector \"bun --watch src/index.ts\" \"mcp-inspector --config mcp.json\"",
		"typecheck": "tsc --noEmit",
		"lint": "biome check .",
		"format": "biome check --write .",
		"test": "vitest run"
	}
}
