{
	"name": "ollygarden-mcp",
	"version": "0.0.1",
	"type": "module",
	"private": true,
	"devDependencies": {
		"@biomejs/biome": "2.5.13",
		"@cloudflare/workers-types": "^5.20260821.1",
		"@modelcontextprotocol/inspector": "^2.3.0",
		"@types/bun": "latest",
		"concurrently": "^10.0.5",
		"vitest": "3.2.7",
		"wrangler": "^4.125.0"
	},
	"peerDependencies": {
		"typescript": "^5"
	},
	"dependencies": {
		"@clerk/hono": "^0.1.71",
		"@clerk/mcp-tools": "^0.6.0",
		"@modelcontextprotocol/server": "^2.0.0",
		"hono": "^4.13.3",
		"zod": "^4.4.3"
	},
	"scripts": {
		"dev": "concurrently -k -n worker,inspector \"wrangler dev\" \"mcp-inspector --config mcp.json\"",
		"typecheck": "tsc --noEmit",
